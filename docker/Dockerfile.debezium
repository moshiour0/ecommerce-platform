FROM confluentinc/cp-kafka-connect-base:7.5.0

USER root

# Download Debezium PostgreSQL connector from Maven Central (Unblockable CDN)
RUN curl -fsSL -o /tmp/debezium-postgres.tar.gz \
    https://repo1.maven.org/maven2/io/debezium/debezium-connector-postgres/2.4.0.Final/debezium-connector-postgres-2.4.0.Final-plugin.tar.gz \
    && mkdir -p /usr/share/confluent-hub-components/debezium-postgres \
    && tar -xzf /tmp/debezium-postgres.tar.gz -C /usr/share/confluent-hub-components/debezium-postgres --strip-components=1 \
    && rm /tmp/debezium-postgres.tar.gz

USER appuser